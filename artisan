#!/usr/bin/env php
<?php
/**
 * Laravel Artisan CLI - Arjuna Carly Portfolio CMS
 */

$app = require_once __DIR__ . '/bootstrap/app.php';

$command = $argv[1] ?? 'list';
$flags = array_slice($argv, 2);

switch ($command) {
    case 'migrate':
        $fresh = in_array('--fresh', $flags, true);
        $app->runMigrations($fresh);
        echo "\033[32mINFO\033[0m  Migrations executed successfully.\n";
        if (in_array('--seed', $flags, true)) {
            $app->runSeeders();
            echo "\033[32mINFO\033[0m  Database seeding completed successfully.\n";
        }
        break;

    case 'migrate:fresh':
        $app->runMigrations(true);
        echo "\033[32mINFO\033[0m  Dropped all tables and re-ran migrations successfully.\n";
        if (in_array('--seed', $flags, true)) {
            $app->runSeeders();
            echo "\033[32mINFO\033[0m  Database seeding completed successfully.\n";
        }
        break;

    case 'db:seed':
        $app->runSeeders();
        echo "\033[32mINFO\033[0m  Database seeding completed successfully.\n";
        break;

    case 'serve':
        $host = '127.0.0.1';
        $port = '8000';
        foreach ($flags as $flag) {
            if (strpos($flag, '--port=') === 0) {
                $port = substr($flag, 7);
            } elseif (strpos($flag, '--host=') === 0) {
                $host = substr($flag, 7);
            }
        }
        echo "\033[32mINFO\033[0m  Laravel development server started on [http://{$host}:{$port}].\n";
        echo "  -> Website Portofolio   : http://{$host}:{$port}/\n";
        echo "  -> Semua Projek         : http://{$host}:{$port}/projects\n";
        echo "  -> Dashboard Admin CMS  : http://{$host}:{$port}/admin\n";
        echo "  Press Ctrl+C to stop the server\n\n";
        passthru('"' . PHP_BINARY . '" -S ' . $host . ':' . $port . ' -t "' . __DIR__ . '/public" "' . __DIR__ . '/server.php"');
        break;

    default:
        echo "Laravel Framework Artisan CLI (Arjuna Carly Portfolio CMS)\n\n";
        echo "Usage:\n";
        echo "  php artisan serve                 Jalankan server pengembangan Laravel (http://127.0.0.1:8000)\n";
        echo "  php artisan migrate               Jalankan migrasi database\n";
        echo "  php artisan migrate:fresh --seed  Reset database dan isi data awal CV Arjuna\n";
        echo "  php artisan db:seed               Isi data awal (Seeder)\n";
        break;
}
