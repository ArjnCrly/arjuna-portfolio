{
    "name": "arjunacarly/laravel-portfolio",
    "type": "project",
    "description": "Website Portofolio Pribadi Arjuna Carly Dhymas Mahendra - Laravel MVC & Dynamic Admin CMS",
    "keywords": ["laravel", "portfolio", "arjuna-carly", "polinema", "react", "tailwind", "figma"],
    "license": "MIT",
    "require": {
        "php": "^8.0.2",
        "laravel/framework": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
